# For running locally: cp .env.example .env
# On the server (GitHub Actions) the same values live in Settings → Secrets and variables → Actions.

# Token from @BotFather
TG_BOT_TOKEN=
# Your chat id; find it with: python -m bot --whoami
TG_CHAT_ID=

# Criteria. The defaults live in the code; uncomment only what you want to change.
# BRAND=Yamaha
# MODEL_PATTERN=TRACER
# MIN_YEAR=2018
# MIN_RANK=4
# The limit is the final auction price, in yen
# LIMIT_JPY=700000
# From this grade up the limit rises to TOP_LIMIT_JPY
# TOP_RANK=6
# TOP_LIMIT_JPY=730000
# A start over the limit by at most this factor still gets sent, flagged as a near miss
# NEAR_RATIO=1.1
# Skip a lot if similar ones (by the sales archive) usually sell for this many times the limit (0 sends all)
# EXPECT_RATIO=1.3
# How often to check the sites, in minutes (runs in between only read Telegram commands)
# SCAN_EVERY_MIN=180
# Minutes of a site being down before a warning
# ALERT_AFTER_MIN=30
# Daily digest: local hour to send it at (-1 turns it off) and the UTC offset
# DIGEST_HOUR=10
# TZ_OFFSET_HOURS=6
# Where the database lives (default: tracer.db in the repo root)
# DB_FILE=tracer.db
