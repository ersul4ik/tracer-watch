# Для локального запуска: cp .env.example .env
# На сервере (GitHub Actions) те же значения живут в Settings → Secrets and variables → Actions.

# Токен от @BotFather
TG_BOT_TOKEN=
# Твой chat_id — узнать: python3 tracer_watch.py --whoami
TG_CHAT_ID=

# Критерии (это значения по умолчанию, можно не трогать)
BRAND=Yamaha
MODEL_PATTERN=TRACER
MIN_YEAR=2018
MIN_RANK=4
# Лимит ставки на аукционе, иены
LIMIT_JPY=700000
# С такой оценки и выше лимит поднимается до TOP_LIMIT_JPY
TOP_RANK=6
TOP_LIMIT_JPY=730000
# Не слать лот, если средняя цена уже выше лимита в столько раз (0 — слать всё)
MAX_AVG_RATIO=1.4
# Через сколько минут молчания сайта прислать предупреждение
ALERT_AFTER_MIN=30
# Ежедневная сводка: в какой час по местному времени (-1 — не слать) и пояс относительно UTC
DIGEST_HOUR=10
TZ_OFFSET_HOURS=6
